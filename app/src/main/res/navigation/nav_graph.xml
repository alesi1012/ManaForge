<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.manaforge.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_home_to_newDeck"
            app:destination="@id/newDeckFragment" />
        <action
            android:id="@+id/action_home_to_deckDetail"
            app:destination="@id/deckEditorFragment">
            <argument
                android:name="deck"
                app:argType="com.example.manaforge.Deck" />
        </action>
        <action
            android:id="@+id/action_home_to_collection"
            app:destination="@id/collectionFragment" />
    </fragment>

    <fragment
        android:id="@+id/newDeckFragment"
        android:name="com.example.manaforge.NewDeckFragment"
        android:label="New Deck"
        tools:layout="@layout/fragment_new_deck">
        <action
            android:id="@+id/action_newDeck_to_editor"
            app:destination="@id/deckEditorFragment">
            <argument
                android:name="deck"
                app:argType="com.example.manaforge.Deck" />
        </action>
    </fragment>

    <fragment
        android:id="@+id/deckEditorFragment"
        android:name="com.example.manaforge.DeckEditorFragment"
        android:label="Deck Editor"
        tools:layout="@layout/fragment_deck_editor">
        <argument
            android:name="deck"
            app:argType="com.example.manaforge.Deck"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/lifeCounterFragment"
        android:name="com.example.manaforge.LifeCounterFragment"
        android:label="Counter"
        tools:layout="@layout/fragment_life_counter" />

    <fragment
        android:id="@+id/collectionFragment"
        android:name="com.example.manaforge.CollectionFragment"
        android:label="My Collection"
        tools:layout="@layout/fragment_collection">
        <action
            android:id="@+id/action_collection_to_camera"
            app:destination="@id/cameraFragment" />
    </fragment>

    <fragment
        android:id="@+id/cameraFragment"
        android:name="com.example.manaforge.CameraFragment"
        android:label="Scan Card"
        tools:layout="@layout/fragment_camera">
        <action
            android:id="@+id/action_camera_to_scanResult"
            app:destination="@id/scanResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/scanResultFragment"
        android:name="com.example.manaforge.ScanResultFragment"
        android:label="Scan Result"
        tools:layout="@layout/fragment_scan_result">
        <argument
            android:name="imagePath"
            app:argType="string" />
    </fragment>

</navigation>
